                  "max_attempts": {
                    "maximum": 10,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "max_duration_seconds": {
                    "maximum": 86400,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "max_output_bytes": {
                    "maximum": 16777216,
                    "minimum": 1,
                    "type": "integer"
                  }
